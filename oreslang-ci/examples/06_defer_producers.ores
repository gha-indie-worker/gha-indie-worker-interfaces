namespace defer_producer_demo;

type Cleanup = typeof fnc() -> void;

define module resources

  define class File

    pub Close() => Cleanup {
      stdio.println("Close() producer runs now");

      return || -> {
        stdio.println("deferred Close() action runs later");
      };
    }

  end

end

pub routine main() => void {
  val file = new resources.File();

  defer file.Close();

  defer (|| -> {
    stdio.println("self-invoking producer runs now");

    return || -> {
      stdio.println("self-invoked deferred action runs later");
    };
  })();

  stdio.println("body");
  return;
}
