namespace loop_cleanup_demo;

pub routine main() => void {
  let i = 0;

  for (; i < 3; i = i + 1) {
    defer || -> {
      stdio.println(i);
    };

    try {
      if i == 0; do
        continue;
      fi

      if i == 1; do
        break;
      fi
    } catch (err) {
      stdio.println("unexpected catch");
    } finally {
      stdio.println("finally");
    }
  }

  stdio.println("after loop");
  return;
}
