{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gha-indie-worker/gha-indie-worker-interfaces/contracts/json-schema/queue.schema.json",
  "title": "GHA Indie Worker — durable queue",
  "description": "Independently authored JSON Schema authority for durable pull-queue jobs, leases, claim receipts and supersession. Peer of contracts/typespec/queue.tsp; neither is generated from the other.",
  "x-ores-namespace": "GhaIndieWorker.V1.Queue",
  "x-ores-transitions": {
    "$comment": "Queue state transitions are runtime invariants; stale generations and fencing tokens must be rejected by the queue implementation.",
    "queue_state": {
      "queued": ["claimed", "cancelled", "expired"],
      "claimed": ["running", "queued", "cancelled", "expired"],
      "running": ["succeeded", "failed", "cancelled", "expired"],
      "succeeded": [],
      "failed": [],
      "cancelled": [],
      "expired": []
    }
  },
  "$defs": {
    "QueueState": {
      "type": "string",
      "enum": ["queued", "claimed", "running", "succeeded", "failed", "cancelled", "expired"]
    },
    "TrustTier": {
      "type": "string",
      "enum": ["untrusted", "standard", "trusted", "privileged"]
    },
    "CancellationReason": {
      "type": "string",
      "enum": ["user-requested", "policy", "superseded", "lease-expired"]
    },
    "QueueJob": {
      "type": "object",
      "additionalProperties": false,
      "description": "One durable queue row for an immutable repository revision. Secret values and caller-selected shell commands are intentionally absent.",
      "x-ores-table": "ci_queue_jobs",
      "x-ores-primary-key": ["id"],
      "x-ores-unique": [["repository", "revision", "workflow_path", "profile", "attempt", "salt"]],
      "x-ores-indexes": [["state", "available_at"], ["repository", "revision"], ["priority", "enqueued_at"]],
      "required": ["id", "repository", "revision", "workflow_path", "profile", "state", "priority", "enqueued_at", "available_at", "attempt", "salt", "required_os", "required_arch", "required_profile", "required_features", "minimum_trust_tier"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "repository": { "type": "string", "minLength": 3, "maxLength": 140, "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$" },
        "revision": { "type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[0-9a-f]+$" },
        "workflow_path": { "type": "string", "minLength": 1, "maxLength": 255 },
        "profile": { "type": "string", "minLength": 1, "maxLength": 64 },
        "state": { "$ref": "#/$defs/QueueState" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
        "enqueued_at": { "type": "string", "format": "date-time" },
        "available_at": { "type": "string", "format": "date-time" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 50 },
        "salt": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$" },
        "required_os": { "type": "string", "minLength": 1, "maxLength": 32 },
        "required_arch": { "type": "string", "minLength": 1, "maxLength": 32 },
        "required_runtime": { "type": "string", "minLength": 1, "maxLength": 32 },
        "required_profile": { "type": "string", "minLength": 1, "maxLength": 64 },
        "required_features": { "type": "array", "items": { "type": "string" }, "maxItems": 32 },
        "minimum_trust_tier": { "$ref": "#/$defs/TrustTier" },
        "supersedes_job_id": { "type": "string", "format": "uuid" },
        "cancelled_at": { "type": "string", "format": "date-time" },
        "cancellation_reason": { "$ref": "#/$defs/CancellationReason" }
      }
    },
    "JobLease": {
      "type": "object",
      "additionalProperties": false,
      "description": "A renewable lease granting one worker authority over one queue job generation.",
      "x-ores-table": "ci_job_leases",
      "x-ores-primary-key": ["id"],
      "x-ores-unique": [["job_id", "generation"], ["job_id", "fencing_token"]],
      "x-ores-indexes": [["worker_id", "expires_at"], ["expires_at"]],
      "required": ["id", "job_id", "worker_id", "generation", "fencing_token", "attempt", "claimed_at", "heartbeat_at", "expires_at"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "job_id": { "type": "string", "format": "uuid", "x-ores-references": "QueueJob.id" },
        "worker_id": { "type": "string", "format": "uuid" },
        "generation": { "type": "integer", "x-ores-width": 64, "minimum": 1 },
        "fencing_token": { "type": "integer", "x-ores-width": 64, "minimum": 1 },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 50 },
        "claimed_at": { "type": "string", "format": "date-time" },
        "heartbeat_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "released_at": { "type": "string", "format": "date-time" }
      }
    },
    "ClaimReceipt": {
      "type": "object",
      "additionalProperties": false,
      "description": "Immutable capability evidence explaining why a worker was eligible for a claim. Capability names are retained; secret values are not.",
      "x-ores-table": "ci_claim_receipts",
      "x-ores-primary-key": ["id"],
      "x-ores-unique": [["lease_id"]],
      "x-ores-indexes": [["worker_id", "claimed_at"]],
      "required": ["id", "lease_id", "job_id", "worker_id", "generation", "fencing_token", "matched_os", "matched_arch", "matched_profile", "matched_features", "matched_trust_tier", "worker_max_concurrency", "worker_active_jobs", "claimed_at"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "lease_id": { "type": "string", "format": "uuid", "x-ores-references": "JobLease.id" },
        "job_id": { "type": "string", "format": "uuid", "x-ores-references": "QueueJob.id" },
        "worker_id": { "type": "string", "format": "uuid" },
        "generation": { "type": "integer", "x-ores-width": 64, "minimum": 1 },
        "fencing_token": { "type": "integer", "x-ores-width": 64, "minimum": 1 },
        "matched_os": { "type": "string", "minLength": 1, "maxLength": 32 },
        "matched_arch": { "type": "string", "minLength": 1, "maxLength": 32 },
        "matched_runtime": { "type": "string", "minLength": 1, "maxLength": 32 },
        "matched_profile": { "type": "string", "minLength": 1, "maxLength": 64 },
        "matched_features": { "type": "array", "items": { "type": "string" }, "maxItems": 32 },
        "matched_trust_tier": { "$ref": "#/$defs/TrustTier" },
        "worker_max_concurrency": { "type": "integer", "minimum": 1, "maximum": 64 },
        "worker_active_jobs": { "type": "integer", "minimum": 0, "maximum": 64 },
        "claimed_at": { "type": "string", "format": "date-time" }
      }
    },
    "JobSupersession": {
      "type": "object",
      "additionalProperties": false,
      "description": "Audit record linking a cancelled stale job to the immutable replacement that superseded it.",
      "x-ores-table": "ci_job_supersessions",
      "x-ores-primary-key": ["id"],
      "x-ores-unique": [["superseded_job_id"], ["replacement_job_id"]],
      "required": ["id", "superseded_job_id", "replacement_job_id", "created_at"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "superseded_job_id": { "type": "string", "format": "uuid", "x-ores-references": "QueueJob.id" },
        "replacement_job_id": { "type": "string", "format": "uuid", "x-ores-references": "QueueJob.id" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
