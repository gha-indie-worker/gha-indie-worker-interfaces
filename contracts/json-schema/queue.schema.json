{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gha-indie-worker/gha-indie-worker-interfaces/contracts/json-schema/queue.schema.json",
  "title": "GHA Indie Worker — durable CI queue",
  "description": "Independently authored JSON Schema authority for durable CI jobs, fenced leases, hosted-run observations, independent execution evidence, and exact-SHA check publication. Peer of contracts/typespec/queue.tsp; neither is generated from the other.",
  "x-ores-namespace": "GhaIndieWorker.V1.Queue",
  "$defs": {
    "QueueJobStatus": {
      "type": "string",
      "enum": ["queued", "claimed", "running", "succeeded", "failed", "cancelled", "expired", "superseded"]
    },
    "HostedEvidenceClassification": {
      "type": "string",
      "enum": ["non_terminal", "stepful_success", "stepful_failure", "zero_step_runner_admission_failure", "zero_step_unknown", "cancelled"]
    },
    "HostedJobStatus": {
      "type": "string",
      "enum": ["queued", "in_progress", "completed"]
    },
    "HostedJobConclusion": {
      "type": "string",
      "enum": ["success", "failure", "cancelled", "timed_out", "neutral", "skipped", "action_required"]
    },
    "RunnerAdmissionReason": {
      "type": "string",
      "description": "Typed admission reasons derived only from stable machine-readable evidence, never free-form log substring matching.",
      "enum": ["budget_exhausted", "quota_exceeded", "no_eligible_runner", "runner_provisioning_failure", "runner_service_unavailable"]
    },
    "CheckState": {
      "type": "string",
      "enum": ["pending", "success", "failure", "error", "cancelled"]
    },
    "QueueJob": {
      "type": "object",
      "additionalProperties": false,
      "description": "Canonical durable queue row. Cloudflare and NATS may wake consumers but are not competing queue authorities.",
      "x-ores-table": "ci_queue_jobs",
      "x-ores-primary-key": ["id"],
      "x-ores-unique": [["idempotency_key"]],
      "x-ores-indexes": [["status", "priority", "available_at"], ["repository", "revision_sha"]],
      "required": ["id", "repository", "revision_sha", "workflow_path", "profile", "attempt", "idempotency_key", "status", "priority", "required_capabilities", "created_at", "available_at"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "repository": { "type": "string", "minLength": 3, "maxLength": 140, "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$" },
        "revision_sha": { "type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[0-9a-f]+$" },
        "workflow_path": { "type": "string", "minLength": 1, "maxLength": 255 },
        "profile": { "type": "string", "minLength": 1, "maxLength": 64 },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 50 },
        "idempotency_key": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]+$" },
        "status": { "$ref": "#/$defs/QueueJobStatus" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "required_os": { "type": "string", "maxLength": 32 },
        "required_arch": { "type": "string", "maxLength": 32 },
        "required_runtime": { "type": "string", "maxLength": 32 },
        "required_capabilities": { "type": "array", "items": { "type": "string" }, "maxItems": 64 },
        "created_at": { "type": "string", "format": "date-time" },
        "available_at": { "type": "string", "format": "date-time" },
        "claimed_at": { "type": "string", "format": "date-time" },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "superseded_by_job_id": { "type": "string", "format": "uuid" }
      }
    },
    "JobLease": {
      "type": "object",
      "additionalProperties": false,
      "description": "One fenced worker claim. generation is monotonic per job; only the current generation may heartbeat or publish a terminal result.",
      "x-ores-table": "ci_job_leases",
      "x-ores-primary-key": ["id"],
      "x-ores-unique": [["job_id", "generation"]],
      "x-ores-indexes": [["worker_id", "expires_at"], ["job_id", "released_at"]],
      "required": ["id", "job_id", "worker_id", "generation", "lease_token_hash", "leased_at", "heartbeat_at", "expires_at"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "job_id": { "type": "string", "format": "uuid", "x-ores-references": "QueueJob.id" },
        "worker_id": { "type": "string", "format": "uuid", "description": "Foreign identity from the workers slice; intentionally not a cross-slice SQL foreign key here." },
        "generation": { "type": "integer", "minimum": 1 },
        "lease_token_hash": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]+$" },
        "leased_at": { "type": "string", "format": "date-time" },
        "heartbeat_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "released_at": { "type": "string", "format": "date-time" }
      }
    },
    "HostedRunObservation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Observed hosted GitHub job evidence kept separate from independent execution evidence.",
      "x-ores-table": "ci_hosted_run_observations",
      "x-ores-primary-key": ["id"],
      "x-ores-indexes": [["repository", "revision_sha", "observed_at"], ["classification", "observed_at"]],
      "required": ["id", "job_id", "repository", "revision_sha", "github_run_id", "status", "classification", "observed_at"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "job_id": { "type": "string", "format": "uuid", "x-ores-references": "QueueJob.id" },
        "repository": { "type": "string", "minLength": 3, "maxLength": 140 },
        "revision_sha": { "type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[0-9a-f]+$" },
        "github_run_id": { "type": "integer", "minimum": 1 },
        "github_job_id": { "type": "integer", "minimum": 1 },
        "status": { "$ref": "#/$defs/HostedJobStatus" },
        "conclusion": { "$ref": "#/$defs/HostedJobConclusion" },
        "step_count": { "type": "integer", "minimum": 0 },
        "classification": { "$ref": "#/$defs/HostedEvidenceClassification" },
        "admission_reason": { "$ref": "#/$defs/RunnerAdmissionReason" },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "ExecutionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "description": "Independent execution evidence. Secret values are forbidden; only redacted summaries and opaque artifact identifiers belong here.",
      "x-ores-table": "ci_execution_evidence",
      "x-ores-primary-key": ["id"],
      "x-ores-unique": [["job_id", "lease_generation"]],
      "x-ores-indexes": [["worker_id", "finished_at"]],
      "required": ["id", "job_id", "worker_id", "lease_generation", "runtime_backend", "os", "arch", "artifact_ids", "started_at", "finished_at"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "job_id": { "type": "string", "format": "uuid", "x-ores-references": "QueueJob.id" },
        "worker_id": { "type": "string", "format": "uuid" },
        "lease_generation": { "type": "integer", "minimum": 1 },
        "runtime_backend": { "type": "string", "minLength": 1, "maxLength": 32 },
        "os": { "type": "string", "minLength": 1, "maxLength": 32 },
        "arch": { "type": "string", "minLength": 1, "maxLength": 32 },
        "ores_compose_project": { "type": "string", "maxLength": 120 },
        "ores_compose_session": { "type": "string", "maxLength": 120 },
        "artifact_ids": { "type": "array", "items": { "type": "string" }, "maxItems": 64 },
        "redacted_summary": { "type": "string", "maxLength": 2048 },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" }
      }
    },
    "CheckPublication": {
      "type": "object",
      "additionalProperties": false,
      "description": "One external check/status publication attempt. Exact SHA plus lease generation prevents stale workers from publishing green.",
      "x-ores-table": "ci_check_publications",
      "x-ores-primary-key": ["id"],
      "x-ores-unique": [["job_id", "lease_generation", "context"]],
      "x-ores-indexes": [["revision_sha", "published_at"]],
      "required": ["id", "job_id", "lease_generation", "revision_sha", "context", "state", "published_at"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "job_id": { "type": "string", "format": "uuid", "x-ores-references": "QueueJob.id" },
        "lease_generation": { "type": "integer", "minimum": 1 },
        "revision_sha": { "type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[0-9a-f]+$" },
        "context": { "type": "string", "minLength": 1, "maxLength": 120 },
        "state": { "$ref": "#/$defs/CheckState" },
        "external_id": { "type": "string", "maxLength": 160 },
        "published_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
