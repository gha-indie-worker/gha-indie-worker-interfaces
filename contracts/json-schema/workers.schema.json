{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gha-indie-worker/gha-indie-worker-interfaces/contracts/json-schema/workers.schema.json",
  "title": "GHA Indie Worker — workers",
  "description": "Independently authored JSON Schema authority for workers, capabilities, heartbeats and execution profiles. Peer of contracts/typespec/workers.tsp; neither is generated from the other.",
  "x-ores-namespace": "GhaIndieWorker.V1.Workers",
  "$defs": {
    "WorkerStatus": {
      "type": "string",
      "enum": ["registering", "idle", "leased", "draining", "offline"]
    },
    "CapabilityKind": {
      "type": "string",
      "description": "What a capability row asserts. profile is an operator-reviewed profile name, feature is a free capability tag.",
      "enum": ["profile", "arch", "os", "feature"]
    },
    "Worker": {
      "type": "object",
      "additionalProperties": false,
      "description": "A fixed-profile worker pinned to an immutable image digest. Workers never receive caller-selected images.",
      "x-ores-table": "workers",
      "x-ores-primary-key": ["id"],
      "x-ores-unique": [["name"]],
      "x-ores-indexes": [["status", "lastHeartbeatAt"]],
      "required": ["id", "name", "status", "arch", "os", "imageDigest", "maxConcurrency", "registeredAt"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "orgId": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "status": { "$ref": "#/$defs/WorkerStatus" },
        "arch": { "type": "string", "minLength": 1, "maxLength": 32 },
        "os": { "type": "string", "minLength": 1, "maxLength": 32 },
        "imageDigest": { "type": "string", "minLength": 71, "maxLength": 71, "pattern": "^sha256-[0-9a-f]+$" },
        "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 64 },
        "registeredAt": { "type": "string", "format": "date-time" },
        "lastHeartbeatAt": { "type": "string", "format": "date-time" }
      }
    },
    "Capability": {
      "type": "object",
      "additionalProperties": false,
      "description": "One asserted capability of a worker. Disabled rows are retained so scheduling decisions stay auditable.",
      "x-ores-table": "worker_capabilities",
      "x-ores-primary-key": ["id"],
      "x-ores-unique": [["workerId", "kind", "value"]],
      "x-ores-indexes": [["kind", "value"]],
      "required": ["id", "workerId", "kind", "value", "enabled"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "workerId": { "type": "string", "format": "uuid", "x-ores-references": "Worker.id" },
        "kind": { "$ref": "#/$defs/CapabilityKind" },
        "value": { "type": "string", "minLength": 1, "maxLength": 120 },
        "enabled": { "type": "boolean" }
      }
    },
    "Heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "description": "A periodic liveness and load sample from a worker. Absence past the lease window marks the worker offline.",
      "x-ores-table": "worker_heartbeats",
      "x-ores-primary-key": ["id"],
      "x-ores-unique": [["workerId", "observedAt"]],
      "x-ores-indexes": [["observedAt"]],
      "required": ["id", "workerId", "observedAt", "activeJobs", "queueDepth", "loadAverage", "version"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "workerId": { "type": "string", "format": "uuid", "x-ores-references": "Worker.id" },
        "observedAt": { "type": "string", "format": "date-time" },
        "activeJobs": { "type": "integer", "minimum": 0, "maximum": 64 },
        "queueDepth": { "type": "integer", "minimum": 0 },
        "loadAverage": { "type": "number", "minimum": 0 },
        "version": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "Profile": {
      "type": "object",
      "additionalProperties": false,
      "description": "An operator-reviewed execution profile. Commands and artifact paths are compiled in, never caller-supplied.",
      "x-ores-table": "worker_profiles",
      "x-ores-primary-key": ["id"],
      "x-ores-unique": [["name"]],
      "x-ores-indexes": [["reviewedAt"]],
      "required": ["id", "name", "image", "imageDigest", "commands", "artifactPaths", "cpuMillis", "memoryMebibytes", "timeoutSeconds", "reviewedAt"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
        "image": { "type": "string", "minLength": 1, "maxLength": 255 },
        "imageDigest": { "type": "string", "minLength": 71, "maxLength": 71, "pattern": "^sha256-[0-9a-f]+$" },
        "commands": { "type": "array", "items": { "type": "string" }, "maxItems": 64 },
        "artifactPaths": { "type": "array", "items": { "type": "string" }, "maxItems": 32 },
        "cpuMillis": { "type": "integer", "minimum": 100, "maximum": 64000 },
        "memoryMebibytes": { "type": "integer", "minimum": 128, "maximum": 262144 },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "reviewedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
