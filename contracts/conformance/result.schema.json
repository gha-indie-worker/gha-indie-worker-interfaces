{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ores-truffle-oreslang/oreslang-restful-server-perf-benchmarks/contracts/conformance/result.schema.json",
  "title": "HTTP benchmark conformance result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target",
    "passed",
    "checks",
    "failures",
    "benchmarks_run"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "passed": {
      "type": "boolean"
    },
    "checks": {
      "type": "integer",
      "minimum": 0
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "benchmarks_run": {
      "const": false
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
