{
  "name": "@gha-indie-worker/interfaces",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent TypeSpec and JSON Schema contract authorities for GHA Indie Worker, enforced by ores-contracts and TJSV.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gha-indie-worker/gha-indie-worker-interfaces"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "contracts:check": "node node_modules/@oresoftware/ores-contracts/src/cli.mjs check",
    "contracts:check:all": "node scripts/contracts-slices.mjs check",
    "contracts:generate": "node scripts/contracts-slices.mjs generate",
    "contracts:tjsv": "node scripts/tjsv-slices.mjs check",
    "contracts:tjsv:inventory": "node scripts/tjsv-slices.mjs inventory",
    "lint:typespec": "tsp compile contracts/typespec --no-emit",
    "validate:fixtures": "node scripts/validate-fixtures.mjs",
    "validate:fixtures:builtin": "node scripts/validate-fixtures.mjs --engine builtin",
    "lint:js": "eslint --config .ores-lint/eslint.config.mjs scripts",
    "lint:md": "markdownlint-cli2 --config .ores-lint/.markdownlint.jsonc \"**/*.md\" \"!node_modules\" \"!generated\"",
    "lint": "npm run lint:js && npm run lint:md && npm run lint:typespec && npm run validate:fixtures:builtin && npm run validate:fixtures && npm run contracts:tjsv",
    "test": "npm run validate:fixtures:builtin && npm run validate:fixtures && npm run contracts:check:all && npm run contracts:tjsv"
  },
  "devDependencies": {
    "@oresoftware/ores-contracts": "github:ORESoftware/ores-contracts#152f55ae3f8d1a6626249b3dd72ecccb9ff0878c",
    "@typespec/compiler": "1.16.0",
    "@typespec/json-schema": "1.16.0",
    "ajv": "^8.17.1",
    "eslint": "^9.13.0",
    "markdownlint-cli2": "^0.14.0"
  }
}
